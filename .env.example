# ===== 天气 Agent 环境变量模板 =====
# 复制本文件为 .env（不要提交 .env 到 git）
# 然后在终端设置对应环境变量，或使用 python-dotenv 加载

# 必填：大模型 API Key（通义千问）
QWEN_API_KEY=sk-你的key

# 可选：模型名（默认 qwen3.8-flash）
WEATHER_AGENT_MODEL=qwen3.8-flash

# 可选：API 地址（默认通义千问北京地域）
WEATHER_AGENT_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
